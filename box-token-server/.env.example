# Скопируйте этот файл в .env и заполните значениями из своего
# приложения в Box Developer Console (https://app.box.com/developers/console)
# → ваше приложение → Configuration → OAuth 2.0 Credentials.
#
# ВАЖНО: файл .env не должен попасть в git/публичный репозиторий —
# в нём секрет вашего приложения Box.

BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Порт, на котором слушает этот сервер.
PORT=8787

# Через запятую — origin(ы), которым разрешено обращаться к этому
# серверу (реальный адрес вашего сайта, например https://example.com).
# Значение по умолчанию "*" удобно для локальной разработки — в
# продакшене замените на конкретный origin(ы) вашего сайта.
ALLOWED_ORIGIN=*
